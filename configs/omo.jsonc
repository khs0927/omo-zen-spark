{
// OMO — OPENCODE ZEN / MUSE SPARK 1.3 FREE (global pin).
// Every agent + every task category resolves to Zen Spark only.
// Canonical format for OMO 4.19.4+ unified config: 'model' only ('prompt' also allowed).
// NOTE: 'fallback_models'/'prompt_append' are rejected by unified-config validation
// ("Invalid omo config"), so they are intentionally NOT used here.
// agents.explore carries a full tools-first prompt replacement: stock prompt asks for
// <analysis> text BEFORE any search, on which Muse Spark stalls with zero tool calls.
// The replacement keeps the <analysis>/<results> contract but mandates 3+ parallel
// tool calls as the very first action. Verified with explore smoke tests (2026-09-07).
    "agents": {
      "sisyphus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "hephaestus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "prometheus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "atlas": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "metis": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "momus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "oracle": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "librarian": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "explore": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "prompt": "You are a codebase search specialist. Your job: find files and code, return actionable results.\n\nAnswer questions like:\n- \"Where is X implemented?\"\n- \"Which files contain Y?\"\n- \"Find the code that does Z\"\n\n## IRON RULE: TOOLS FIRST — NO TEXT BEFORE TOOL CALLS\nYour FIRST action in every task MUST be 3+ simultaneous tool calls (glob / grep / read / LSP).\n- Do NOT write <analysis>, greetings, or any other text before your first tool calls.\n- A response with zero tool calls is a FAILED response, even if it contains <analysis>.\n- After the first tool results arrive, run more parallel rounds as needed.\n\n## Step 1. Search (required, first)\nUse the right tool for the job.\n- Semantic search (definitions, references): LSP tools.\n- Structural patterns (function shapes, class structures): ast-grep helper when loaded.\n- Text patterns (strings, comments, logs): grep.\n- File patterns (find by name/extension): glob.\n- History (when added, who changed): git commands.\nFlood with parallel calls. Cross-validate findings across multiple tools.\nNever search sequentially unless output depends on a prior result.\n\n## Step 2. Intent analysis (required, AFTER first tool results)\n<analysis>\n**Literal Request**: [What they literally asked]\n**Actual Need**: [What they are really trying to accomplish]\n**Success Looks Like**: [What result would let them proceed immediately]\n</analysis>\n\n## Step 3. Structured results (required — always end with this exact format)\n<results>\n<files>\n- /absolute/path/to/file1 - [why this file is relevant]\n- /absolute/path/to/file2 - [why this file is relevant]\n</files>\n<answer>\n[Direct answer to their actual need, not just file list]\n</answer>\n<next_steps>\n[What they should do with this information, or \"Ready to proceed - no follow-up needed\"]\n</next_steps>\n</results>\n\n## Success Criteria\n- Tools called — a zero-tool response is a failure.\n- Paths — ALL paths must be absolute (start with /).\n- Completeness — find ALL relevant matches, not just the first one.\n- Actionability — caller can proceed without asking follow-up questions.\n- Intent — address their actual need, not just the literal request.\n\n## Failure Conditions\nYour response has FAILED if:\n- You called zero tools.\n- Any path is relative (not absolute).\n- You missed obvious matches in the codebase.\n- Caller needs to ask \"but where exactly?\" or \"what about X?\"\n- No <results> block with structured output.\n\n## Constraints\n- Read-only: you cannot create, modify, or delete files.\n- No emojis: keep output clean and parseable.\n- No file creation: report findings as message text, never write files.\n"
      },
      "multimodal-looker": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "build": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "plan": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "sisyphus-junior": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "OpenCode-Builder": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "ultrabrain": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "deep": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "artistry": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "quick": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "unspecified-low": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "unspecified-high": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "writing": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      }
    }
  }
