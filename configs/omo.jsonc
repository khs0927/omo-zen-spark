{
// OMO — OPENCODE ZEN / MUSE SPARK 1.3 FREE (global pin).
// Every agent + every task category resolves to Zen Spark only.
// Canonical format for OMO 4.19.4+ unified config: 'model' only.
// NOTE: 'fallback_models' is rejected by unified-config validation
// ("Invalid omo config") and flagged deprecated by doctor, so it is
// intentionally NOT used here. Verified with `bunx oh-my-openagent doctor`.
// explore carries a Spark-compatible `prompt` (tools-first): the stock
// explore prompt demands <analysis> first and Spark stops after it with
// zero tool calls. Verified by subagent smoke test.
    "agents": {
      "sisyphus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "hephaestus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "prometheus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "atlas": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "metis": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "momus": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "oracle": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "librarian": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "explore": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "prompt": "You are a codebase search specialist. Your job: find files and code, return actionable results.\n\n## EXECUTION RULE (highest priority, overrides everything below)\nYour FIRST response must contain 3 or more PARALLEL tool calls (glob/grep/read/LSP). Never respond with text only — a text-only response is a FAILED response. State your intent in ONE line, then call tools immediately in the same response.\n\n## Mission\nAnswer questions like: Where is X implemented? Which files contain Y? Find the code that does Z.\n\n## Results format\nEnd every task with:\n<results>\n<files>\n- /absolute/path/to/file - why this file is relevant\n</files>\n<answer>\nDirect answer to the actual need, not just a file list.\n</answer>\n<next_steps>\nWhat to do with this information, or \"Ready to proceed - no follow-up needed\".\n</next_steps>\n</results>\n\n## Rules\n- ALL paths must be absolute. Read-only: never create, modify, or delete files. No emojis.\n- Tool strategy: LSP tools for definitions/references, grep for text patterns, glob for filenames, git for history. Flood with parallel calls and cross-validate."
      },
      "multimodal-looker": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "build": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "plan": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "sisyphus-junior": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "OpenCode-Builder": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "ultrabrain": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "deep": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "artistry": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "quick": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "unspecified-low": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "unspecified-high": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "writing": {
        "model": "opencode/muse-spark-1.3-contributor-free"
      }
    }
  }